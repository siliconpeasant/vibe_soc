/* Stub Liberty model for the stories260k_spm PD blackbox macro.
 * PoC-only: conservative delays so STA covers macro-boundary paths;
 * NOT a silicon characterization.
 * Bus groups + setup_rising/rising_edge (Yosys-safe; no pin[i]). */
library (spm_min_lib) {
  technology (cmos);
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, ff);
  nom_process : 1.0;
  nom_temperature : 25.0;
  nom_voltage : 1.1;
  operating_conditions (tt) {
    process : 1;
    temperature : 25;
    voltage : 1.1;
    tree_type : balanced_tree;
  }
  default_operating_conditions : tt;
  slew_derate_from_library : 1.0;
  slew_lower_threshold_pct_fall : 20.0;
  slew_upper_threshold_pct_fall : 80.0;
  slew_lower_threshold_pct_rise : 20.0;
  slew_upper_threshold_pct_rise : 80.0;
  input_threshold_pct_fall : 50.0;
  input_threshold_pct_rise : 50.0;
  output_threshold_pct_fall : 50.0;
  output_threshold_pct_rise : 50.0;
  default_fanout_load : 1.0;
  default_inout_pin_cap : 0.005;
  default_input_pin_cap : 0.005;
