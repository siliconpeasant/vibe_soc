{
  "schema_version": 1,
  "mode_order": [
    "dev",
    "merge",
    "signoff"
  ],
  "default_mode": "dev",
  "modes": {
    "dev": {
      "purpose": "Fast inner-loop work on one module without closing delivery stages.",
      "review_mode": "not_run",
      "close_pipeline": false,
      "required_checks": [
        "soc_lint",
        "targeted_soc_sim_or_soc_comp",
        "rtl_quality"
      ],
      "rules": []
    },
    "merge": {
      "purpose": "Close the final module diff once before PR or automatic merge.",
      "review_mode": "normal",
      "close_pipeline": true,
      "required_checks": [
        "doc_delta",
        "soc_lint",
        "soc_comp",
        "rtl_quality",
        "soc_sim",
        "sim_log",
        "soc_syn",
        "loop_review_normal"
      ],
      "rules": [
        ".agents/rules/01_swarm_flow.md",
        ".agents/rules/02_toolchain.md",
        ".agents/rules/05_pipeline_state.md",
        ".agents/rules/13_review_gate.md"
      ]
    },
    "signoff": {
      "purpose": "Run the full high-risk delivery flow for integration and implementation changes.",
      "review_mode": "strict",
      "close_pipeline": true,
      "required_checks": [
        "architecture_doc_delta",
        "soc_lint",
        "soc_comp",
        "rtl_quality",
        "soc_sim",
        "sim_log",
        "soc_syn",
        "risk_specific_checks",
        "loop_review_strict"
      ],
      "rules": [
        ".agents/rules/01_swarm_flow.md",
        ".agents/rules/02_toolchain.md",
        ".agents/rules/05_pipeline_state.md",
        ".agents/rules/13_review_gate.md"
      ]
    }
  },
  "routing": {
    "material_globs": [
      "**/docs/**",
      "**/de/rtl/**",
      "**/de/syn/**",
      "**/de/run/rtl.f",
      "**/dv/tb/**",
      "**/dv/tests/**"
    ],
    "lightweight_globs": [
      "**/dv/tests/**"
    ],
    "merge_globs": [
      "**/de/rtl/filelist.f",
      "**/de/rtl/filelist.mk",
      "**/de/run/rtl.f"
    ],
    "signoff_globs": [
      "chip/top/de/rtl/**",
      "pd/openroad/**",
      "**/*.sdc",
      "**/*.upf",
      "**/docs/interface*.md",
      "**/docs/regmap*.md",
      "**/de/rtl/vendor/**",
      "**/de/rtl/generated/**",
      "**/de/rtl/**/*clock*",
      "**/de/rtl/**/*clk*",
      "**/de/rtl/**/*reset*",
      "**/de/rtl/**/*rst*",
      "**/de/rtl/**/*crg*",
      "**/de/rtl/**/*cdc*",
      "**/de/rtl/**/*rdc*",
      "**/de/rtl/**/*wrapper*",
      "**/de/rtl/**/*_top.v",
      "**/de/rtl/**/*_top.sv",
      "**/de/rtl/**/*regs*",
      "**/de/rtl/**/*csr*"
    ],
    "signoff_impacts": [
      "interface",
      "clock",
      "reset",
      "registers",
      "integration",
      "constraints",
      "power",
      "pd",
      "multi-module"
    ]
  }
}
