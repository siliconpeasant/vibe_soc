{
  "schema_version": 1,
  "launcher": "scripts/mcp_python.sh",
  "client_prefix": "silicon-crew:",
  "servers": [
    {
      "name": "soc-build",
      "script": ".agents/skills/soc-build/mcp_server.py",
      "default_enabled": true,
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 43200
    },
    {
      "name": "soc-integrate",
      "script": ".agents/skills/soc-integrate/mcp_server.py",
      "default_enabled": false,
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 300
    },
    {
      "name": "yml2reg",
      "script": ".agents/skills/yml2reg/mcp_server.py",
      "default_enabled": true,
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 300
    },
    {
      "name": "excel-yml-gen",
      "script": ".agents/skills/excel-yml-gen/mcp_server.py",
      "default_enabled": true,
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 300
    },
    {
      "name": "upf-gen",
      "script": ".agents/skills/upf-gen/mcp_server.py",
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 300
    },
    {
      "name": "crg-req-to-design",
      "script": ".agents/skills/crg-req-to-design/mcp_server.py",
      "default_enabled": true,
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 300
    },
    {
      "name": "cr-tree-diag-gen",
      "script": ".agents/skills/cr-tree-diag-gen/mcp_server.py",
      "default_enabled": true,
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 300
    },
    {
      "name": "soc-openroad",
      "script": ".agents/skills/soc-openroad/mcp_server.py",
      "default_enabled": false,
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 7500
    },
    {
      "name": "openroad-mcp",
      "command": "/usr/bin/env",
      "args": [
        "-u",
        "PYTHONHOME",
        "-u",
        "PYTHONPATH",
        "FASTMCP_SHOW_SERVER_BANNER=false",
        "LOG_LEVEL=ERROR",
        ".openroad-mcp-venv/bin/openroad-mcp",
        "--log-level",
        "ERROR"
      ],
      "cwd": ".",
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 120
    }
  ]
}
