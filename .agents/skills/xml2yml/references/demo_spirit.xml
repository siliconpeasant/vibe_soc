<?xml version="1.0" ?>
<spirit:component xmlns:spirit="http://www.siliconpeasant.com">
  <spirit:name>DEMO_SYS_CTRL</spirit:name>
  <spirit:version>1.0</spirit:version>
  <spirit:addressBlock>
