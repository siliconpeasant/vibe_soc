        <spirit:bitOffset>1</spirit:bitOffset>
        <spirit:bitWidth>1</spirit:bitWidth>
        <spirit:access>RW</spirit:access>
        <spirit:lockOffset>16</spirit:lockOffset>
        <spirit:lockWidth>1</spirit:lockWidth>
        <spirit:lockValue>0x1</spirit:lockValue>
      </spirit:field>
    </spirit:register>
    <spirit:register>
      <spirit:name>scratch</spirit:name>
      <spirit:description>scratch pad</spirit:description>
      <spirit:addressOffset>0x8</spirit:addressOffset>
      <spirit:size>32</spirit:size>
